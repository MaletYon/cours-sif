% --- Q. Indicateur de niveau (bannière de chapitre) ---
% Usage : \niveauChapitre{Fondamental}{Ce chapitre ne requiert aucun prérequis.}
\newcommand{\niveauChapitre}[2]{%
    \begin{tcolorbox}[
        enhanced,
        colback=white,
        colframe=CouleurBordInfo,
        arc=2pt, boxrule=0.5pt,
        left=4pt, right=4pt, top=4pt, bottom=4pt,
        before upper={\small}
    ]
    \textbf{Niveau :}~\textit{#1}\quad\textbullet\quad #2
    \end{tcolorbox}%
}


