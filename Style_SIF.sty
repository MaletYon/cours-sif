\newtcolorbox{boxlecture}[2][]{
    enhanced, breakable,
    colback=CouleurCROFond, colframe=CouleurBordCRO,
    fonttitle=\bfseries\color{white},
    title={\faIcon{balance-scale}\quad Lecture auditologique · #2},
    attach boxed title to top left={yshift=-2mm, xshift=4mm}, varwidth boxed title*=-12mm,
    boxed title style={colback=CouleurCRO, rounded corners},
    arc=3pt, boxrule=0.8pt, left=6pt, right=6pt, top=8pt, bottom=6pt, #1
}
