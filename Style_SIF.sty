% XI. TABLEAUX
% ==============================================================================

% La couleur de fond de la ligne d'en-tete est posee par tableaucours ;
% \tableauHeader ne fait que la mise en forme du texte de chaque cellule.
\newcommand{\tableauHeader}[1]{%
    \color{white}\bfseries #1%
}
\newcommand{\ligneTableau}[1]{%
    \rowcolor{TableauPair} #1
}

% [H] : le tableau reste a sa place (sa legende manuelle le suit) et peut
% etre utilise a l'interieur des encadres tcolorbox.
\newenvironment{tableaucours}[2]{%
    \begin{table}[H]
    \centering\small
    \rowcolors{2}{TableauPair}{TableauImpair}
    \begin{adjustbox}{max width=\linewidth}\begin{tabular}{#1}
    \toprule
    \rowcolor{TableauEntete}#2 \\
    \midrule
}{%
    \bottomrule
    \end{tabular}\end{adjustbox}
    \end{table}
}


